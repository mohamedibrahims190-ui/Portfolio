<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Mohamed Ibrahim | Full Stack Developer")</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Portfolio.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

</head>
<body>
    <canvas id="galaxyCanvas"></canvas>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script src="~/js/galaxy.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/emailjs-com@3/dist/email.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {

            /* ===============================
               Typing Animation
            =============================== */

            const nameText = "\u00A0Mohamed Ibrahim";
            const titles = [
                ".NET Software Developer",
                "Backend / API Developer",
                "Full Stack .NET Developer"
            ];

            const nameEl = document.getElementById("name");
            const titleEl = document.getElementById("title");

            let nameIndex = 0;
            let titleIndex = 0;
            let roleIndex = 0;

            const typingSpeed = 70;
            const erasingSpeed = 50;
            const delayAfterTyping = 1500;

            function typeName() {
                if (nameIndex < nameText.length) {
                    nameEl.textContent += nameText.charAt(nameIndex++);
                    setTimeout(typeName, typingSpeed);
                } else {
                    setTimeout(typeTitle, 500);
                }
            }

            function typeTitle() {
                const currentTitle = titles[roleIndex];
                if (titleIndex < currentTitle.length) {
                    titleEl.textContent += currentTitle.charAt(titleIndex++);
                    setTimeout(typeTitle, typingSpeed);
                } else {
                    setTimeout(eraseTitle, delayAfterTyping);
                }
            }

            function eraseTitle() {
                if (titleIndex > 0) {
                    titleEl.textContent = titles[roleIndex].substring(0, --titleIndex);
                    setTimeout(eraseTitle, erasingSpeed);
                } else {
                    roleIndex = (roleIndex + 1) % titles.length;
                    setTimeout(typeTitle, typingSpeed);
                }
            }

            typeName();

            // ===============================
             // Connect Card Modal
             // ===============================
             
             const connectBtn = document.getElementById("connectBtn");
             const connectCard = document.getElementById("connectCard");
             const closeCard = document.getElementById("closeCard");
             const overlay = document.getElementById("overlay");
             
             if (connectBtn && connectCard && closeCard && overlay) {
             
                 const openModal = () => {
             
                     connectCard.classList.add("active");
                     overlay.classList.add("active");
             
                     document.body.classList.add("connect-open");
             
                     connectBtn.setAttribute("aria-expanded", "true");
             
                     setTimeout(() => {
                         closeCard.focus();
                     }, 100);
                 };
             
             
                 const closeModal = () => {
             
                     connectCard.classList.remove("active");
                     overlay.classList.remove("active");
             
                     document.body.classList.remove("connect-open");
             
                     connectBtn.setAttribute("aria-expanded", "false");
             
                     connectBtn.focus();
                 };
             
             
                 connectBtn.addEventListener("click", openModal);
             
                 closeCard.addEventListener("click", closeModal);
             
                 overlay.addEventListener("click", closeModal);
             
             
                 document.addEventListener("keydown", (event) => {
             
                     if (
                         event.key === "Escape" &&
                         connectCard.classList.contains("active")
                     ) {
                         closeModal();
                     }
             
                 });
             
             }

            /* ===============================
               Copy Email
            =============================== */

            window.copyEmail = function () {
                const emailEl = document.getElementById("emailText");
                const icon = document.getElementById("copyIcon");

                if (!emailEl || !icon) return;

                navigator.clipboard.writeText(emailEl.textContent).then(() => {
                    icon.classList.replace("bi-copy", "bi-check-circle-fill");

                    setTimeout(() => {
                        icon.classList.replace("bi-check-circle-fill", "bi-copy");
                    }, 2000);
                });
            };
        });

        /* ===============================
               Five page scrolling and active button logic
           =============================== */
        const navButtons = document.querySelectorAll(".nav-btn");
        const sections = document.querySelectorAll("section");

        // Smooth scroll on click
        navButtons.forEach(btn => {
            btn.addEventListener("click", e => {
                if (btn.classList.contains("btn-resume")) return; /*Resume download*/
                e.preventDefault();
                const targetId = btn.getAttribute("href").substring(1);
                const targetSection = document.getElementById(targetId);

                targetSection.scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });

                // Optional: highlight immediately on click
                navButtons.forEach(b => b.classList.remove("active"));
                btn.classList.add("active");
            });
        });

        /* ===============================
            Sticky nav button active based on scroll
           =============================== */
        const observer = new IntersectionObserver(
    entries => {
        entries.forEach(entry => {

            if (entry.isIntersecting) {

                navButtons.forEach(btn => {
                    btn.classList.remove("active");
                });

                const activeBtn = document.querySelector(
                    `.nav-btn[href="#${entry.target.id}"]`
                );

                if (activeBtn) {
                    activeBtn.classList.add("active");
                }
            }
        });
    },
    {
        rootMargin: "-30% 0px -60% 0px",
        threshold: 0
    }
);

         /* ===============================
            Email Trigger
           =============================== */
        document.addEventListener("DOMContentLoaded", function () {

            // Initialize EmailJS
            emailjs.init("QMhiKCCu56tYVMZ04");

            var form = document.getElementById("contact-form");
            var timeInput = document.getElementById("time");

            // Exit safely if form does not exist on this page
            if (!form || !timeInput) {
                return;
            }

            form.addEventListener("submit", function (e) {
                e.preventDefault();

                // Set time just before sending
                timeInput.value = new Date().toLocaleString();

                emailjs.sendForm(
                    "service_q25lgik",
                    "template_a8uva2a",
                    form
                ).then(
                    function () {
                        alert("Message sent successfully");
                        form.reset();
                    },
                    function (error) {
                        console.error("EmailJS Error:", error);
                        alert("Failed to send message");
                    }
                );
            });
        });

        sections.forEach(section => observer.observe(section));

    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
